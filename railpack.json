{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22",
    "rust": "stable"
  },
  "steps": {
    "wasm-build": {
      "inputs": [{ "local": true }],
      "commands": [
        "rustup target add wasm32-unknown-unknown",
        "curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh",
        "wasm-pack build crates/wasm --target no-modules --out-dir ../../web/public/wasm --release"
      ]
    },
    "install": {
      "inputs": [{ "local": true }],
      "commands": ["cd web && npm ci"]
    },
    "build": {
      "inputs": [
        { "step": "install" },
        { "step": "wasm-build" }
      ],
      "commands": ["cd web && npm run build"]
    }
  },
  "deploy": {
    "startCommand": "cd web && npm run start"
  }
}
